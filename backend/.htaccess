# Protect sensitive backend files from direct HTTP access
<FilesMatch "^\.(env|git)|(database\.sql|dbConnect\.php|local_tna_db\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

